# Copy to .env and fill in. Never commit .env.

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Leave a key empty to run that part in demo mode:
#   no GEMINI_API_KEY  -> sample receipt + simple rule-based splitting
#   no PayPal keys     -> invoices are simulated, nothing is sent
